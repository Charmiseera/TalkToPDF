<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PDF Chat Assistant - AI-Powered Document Q&A</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <h1>📄 PDF Chat</h1>
            <p>Upload your PDF and ask questions about its content using AI</p>

            <div class="upload-section" id="upload-area">
                <div class="upload-icon">📎</div>
                <h3>Upload PDF Document</h3>
                <p>Drag & drop or click to browse</p>

                <input type="file" id="pdf-file" accept=".pdf">
                <button class="upload-btn" id="upload-btn" disabled>Upload PDF</button>

                <div class="upload-status">
                    <span class="file-name"></span>
                </div>
            </div>
        </aside>

        <!-- Main Chat Area -->
        <main class="main-content">
            <header class="chat-header">
                <h2>Chat with your PDF</h2>
            </header>

            <div class="messages-container" id="messages">
                <div class="empty-state">
                    <div class="empty-state-icon">💬</div>
                    <h3>Welcome to PDF Chat Assistant</h3>
                    <p>Upload a PDF document to get started. Once uploaded, you can ask questions about its content and
                        get AI-powered answers.</p>
                </div>
            </div>

            <div class="input-area">
                <div class="input-wrapper">
                    <textarea id="question-input" placeholder="Upload a PDF first to start chatting..." rows="1"
                        disabled></textarea>
                    <button id="send-btn" disabled>Send</button>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/chat.js"></script>
</body>

</html>